    "/template-elements/{id}" : {
      "get" : {
        "description" : "Dereference the bare identifier ending an artifact's @id. The resource server enforces the caller's read permission and workspace access and returns the stored JSON. Repo preserves its response body, status and representation headers.",
        "operationId" : "findTemplateElement",
        "parameters" : [ {
          "description" : "The bare identifier ending the artifact's IRI.",
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SchemaArtifactDocument"
                }
              }
            },
            "description" : "The stored template element"
          },
          "401" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CedarError"
                }
              }
            },
            "description" : "No valid credentials"
          },
          "403" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CedarError"
                }
              }
            },
            "description" : "The caller lacks read permission or access to this artifact"
          },
          "404" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CedarError"
                }
              }
            },
            "description" : "No such artifact"
          },
          "500" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CedarError"
                }
              }
            },
            "description" : "Internal server error"
          },
          "503" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CedarError"
                }
              }
            },
            "description" : "A required downstream service is unavailable"
          }
        },
        "security" : [ {
          "api_key" : [ ]
        } ],
        "summary" : "Resolve a template element identifier",
        "tags" : [ "Template elements" ]
      }
    },
